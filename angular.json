{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "shyland-dev",
  "projects": {
    "utils": {
      "projectType": "library",
      "root": "shyland-dev/utils",
      "sourceRoot": "shyland-dev/utils/src",
      "prefix": "shy",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "shyland-dev/utils/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "shyland-dev/utils/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    },
    "ui": {
      "projectType": "library",
      "root": "shyland-dev/ui",
      "sourceRoot": "shyland-dev/ui/src",
      "prefix": "shy",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "shyland-dev/ui/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "shyland-dev/ui/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  }
}
