{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "src",
  "projects": {
    "utils": {
      "projectType": "library",
      "root": "src/libs/utils",
      "sourceRoot": "src/libs/utils/src",
      "prefix": "shy",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "src/libs/utils/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "src/libs/utils/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    },
    "ui": {
      "projectType": "library",
      "root": "src/libs/ui",
      "sourceRoot": "src/libs/ui/src",
      "prefix": "shy",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "src/libs/ui/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "src/libs/ui/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    },
    "showcase": {
      "projectType": "application",
      "root": "src/apps",
      "sourceRoot": "src/apps",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/showcase",
            "index": "src/apps/index.html",
            "browser": "src/apps/main.ts",
            "tsConfig": "src/apps/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "src/apps/assets",
                "output": "assets"
              }
            ],
            "styles": ["src/apps/styles.scss"],
            "stylePreprocessorOptions": {
              "includePaths": ["src/libs/ui/src/lib"]
            }
          },
          "configurations": {
            "production": {
              "optimization": true
            },
            "development": {
              "optimization": false
            }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "showcase:build:production"
            },
            "development": {
              "buildTarget": "showcase:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
