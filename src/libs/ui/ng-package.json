{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "assets": [
    {
      "glob": "**/*.scss",
      "input": "src/lib/styles",
      "output": "./styles"
    },
    {
      "glob": "**/*.css",
      "input": "src/lib/styles",
      "output": "./styles"
    },
    {
      "glob": "**/*.woff2",
      "input": "src/lib/styles",
      "output": "./styles"
    },
    {
      "glob": "**/OFL.txt",
      "input": "src/lib/styles",
      "output": "./styles"
    }
  ],
  "dest": "dist/ui"
}
